{
    "env": {
        "project_include_path": [
            "${workspaceFolder}",
            "${workspaceFolder}/FreeRTOS/Source/include",
            "${workspaceFolder}/FreeRTOS/Source/portable/MPLAB/PIC24_dsPIC",
            "${workspaceFolder}/mcc_generated_files"
        ],
        "xc16_defines": [
            "__XC16__",
            "__PIC24E__",
            "__24EP128MC206__",
            "__PIC24EP128MC206__",
            "XPRJ_default=default"
        ]
    },
    "configurations": [
        {
            "name": "XC16 Linux",
            "includePath": [
                "${project_include_path}",
                "/opt/microchip/mplabx/v6.35/packs/Microchip/dsPIC33E-GM-GP-MC-GU-MU_DFP/1.7.401/xc16/support/PIC24E/h",
                "/opt/microchip/mplabx/v6.35/packs/Microchip/dsPIC33E-GM-GP-MC-GU-MU_DFP/1.7.401/xc16/support/generic/h",
                "/opt/microchip/xc16/v2.10/include",
                "/opt/microchip/xc16/v2.10/support/generic/h",
                "/opt/microchip/xc16/v2.10/support/PIC24E/h"
            ],
            "defines": [
                "${xc16_defines}"
            ],
            "compilerPath": "/opt/microchip/xc16/v2.10/bin/xc16-gcc",
            "compilerArgs": [
                "-mcpu=24EP128MC206"
            ],
            "cStandard": "gnu99",
            "cppStandard": "gnu++14",
            "intelliSenseMode": "linux-gcc-x64"
        },
        {
            "name": "XC16 macOS",
            "includePath": [
                "${project_include_path}",
                "${env:HOME}/.mchp_packs/Microchip/dsPIC33E-GM-GP-MC-GU-MU_DFP/1.7.401/xc16/support/PIC24E/h",
                "${env:HOME}/.mchp_packs/Microchip/dsPIC33E-GM-GP-MC-GU-MU_DFP/1.7.401/xc16/support/generic/h",
                "/Applications/microchip/xc16/v2.10/include",
                "/Applications/microchip/xc16/v2.10/support/generic/h",
                "/Applications/microchip/xc16/v2.10/support/PIC24E/h"
            ],
            "defines": [
                "${xc16_defines}"
            ],
            "compilerPath": "/Applications/microchip/xc16/v2.10/bin/xc16-gcc",
            "compilerArgs": [
                "-mcpu=24EP128MC206"
            ],
            "cStandard": "gnu99",
            "cppStandard": "gnu++14",
            "intelliSenseMode": "macos-gcc-arm64"
        }
    ],
    "version": 4
}
